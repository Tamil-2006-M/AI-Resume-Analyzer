# ==================================================================
# .env.example  -  TEMPLATE FILE (safe to commit to GitHub)
# ==================================================================
# Copy this file, rename the copy to ".env", and fill in real values.
# The real ".env" file is listed in .gitignore so it is NEVER uploaded.
#
# Windows PowerShell:   Copy-Item .env.example .env
# Git Bash / Linux:     cp .env.example .env
# ==================================================================

# ---------- Flask settings (Phase 1) ----------
# A long random string. Flask uses it to sign session cookies.
# Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(24))"
SECRET_KEY=put-a-long-random-string-here

# True while developing (auto-reload + detailed errors).
# ALWAYS set this to False on a real server.
FLASK_DEBUG=True

# Port the development server listens on.
PORT=5000

# Who can reach the development server.
#   127.0.0.1 = this computer only (default, safest)
#   0.0.0.0   = also phones/laptops on the same Wi-Fi, for mobile testing
HOST=127.0.0.1


# ==================================================================
# AI / LLM settings (Phase 5)
# ==================================================================
# The app works WITHOUT any key - it falls back to rule-based advice.
# Add a key below to unlock AI-written feedback.

# Which provider to use: openai | anthropic | gemini | ollama
AI_PROVIDER=openai

# Set to false to skip the AI call entirely and always use the
# built-in rules (useful for offline demos and for saving credit).
AI_ENABLED=true

# Seconds to wait for the AI before giving up.
AI_TIMEOUT=45

# ---- OpenAI ---- https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Anthropic (Claude) ---- https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Google Gemini ---- https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Ollama (runs on your own PC, free, no key) ----
# Install from https://ollama.com then run:  ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ==================================================================
# MySQL database (Phase 7)
# ==================================================================
# The app works WITHOUT a database - it just does not save history.
# Set DB_ENABLED=true after you have run sql/schema.sql.

DB_ENABLED=false

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=resume_analyzer

# How many connections to keep open and reuse.
DB_POOL_SIZE=5

# Store the full resume text in the database?
# Useful for re-analysis, but it is personal data - set to false if you
# would rather not keep it.
DB_STORE_RESUME_TEXT=true

# ==================================================================
# Security settings (Phase 9)
# ==================================================================

# Rate limiting: at most RATE_LIMIT_MAX uploads per IP address inside
# RATE_LIMIT_WINDOW seconds. Set RATE_LIMIT_MAX=0 to switch it off.
RATE_LIMIT_MAX=12
RATE_LIMIT_WINDOW=300

# Delete uploaded resumes older than this many hours.
# A resume is personal data - keeping it forever, for no reason, is how
# data breaches happen. Set to 0 to keep files indefinitely.
UPLOAD_RETENTION_HOURS=24

# Only set this to true when the app really is behind a reverse proxy
# you control (nginx, Render, Heroku). It makes the rate limiter trust
# the X-Forwarded-For header - which a client can otherwise fake to
# bypass the limit.
TRUST_PROXY=false
